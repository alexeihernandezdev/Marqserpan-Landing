# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# Neon (rama dev en local; Vercel la inyecta con la integración de Neon)
DATABASE_URL=

# 32+ caracteres aleatorios: openssl rand -base64 32
SESSION_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Resend (EMAIL_FROM=onboarding@resend.dev hasta tener dominio propio)
RESEND_API_KEY=
EMAIL_FROM=

# Usuario predeterminado del admin: se crea en cada despliegue si su correo no existe; nunca
# se sobrescribe. Luego la contraseña se cambia en el admin o con «¿Olvidaste tu contraseña?».
# Con EMAIL_FROM=onboarding@resend.dev, el correo de recuperación solo llega a la dueña de la
# cuenta de Resend: usa ese mismo correo aquí.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# URL pública del sitio, sin barra final (http://localhost:3000 en local)
NEXT_PUBLIC_SITE_URL=

# true en local y vistas previas para mostrar las redes de prueba; sin definir en producción
SHOW_TEST_SOCIALS=

# Para pruebas e2e: copia a .env.test con una rama de Neon exclusiva para pruebas.
E2E_TESTING=
E2E_TESTING_SECRET=
